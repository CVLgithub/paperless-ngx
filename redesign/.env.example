# Paperless-ngx Redesign Test-Instanz Konfiguration
# Kopiere diese Datei nach .env und ersetze alle Platzhalter durch sichere, zufällige Werte.
# ACHTUNG: .env darf NIEMALS in Git eingecheckt werden!

# Host-Port (gebunden an 127.0.0.1 und 100.120.88.96, NICHT 0.0.0.0)
REDESIGN_HOST_PORT=8090

# PostgreSQL-Zugangsdaten
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DB_PASSWORD

# Django Secret Key (z. B. openssl rand -hex 32)
PAPERLESS_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# Initialer Admin-Benutzer (wird beim ersten Start automatisch angelegt)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
PAPERLESS_ADMIN_MAIL=admin@example.local

# Öffentliche URL (hinter Docker-Caddy), erlaubte Hosts und CSRF-Origins
PAPERLESS_URL=https://paperless-r.pi
PAPERLESS_ALLOWED_HOSTS=paperless-r.pi,127.0.0.1,localhost,100.120.88.96
PAPERLESS_CSRF_TRUSTED_ORIGINS=https://paperless-r.pi,http://127.0.0.1:8090,http://localhost:8090,http://100.120.88.96:8090

# Zeitzone & Sprache (Deutsch als Standard)
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_OCR_LANGUAGES=deu eng
PAPERLESS_DATE_PARSER_LANGUAGES=de
PAPERLESS_LANGUAGE=de-de

# Optional: Dateiname / Worker-Tuning für lokale Test-Instanz
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=2
